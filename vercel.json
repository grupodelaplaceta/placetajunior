{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/centros(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY",
        "Cross-Origin-Opener-Policy": "same-origin-allow-popups",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' https://accounts.google.com/gsi/style 'unsafe-hashes' 'sha256-RU4sU0AaS8IBGZx8XrGt/pa9A5SLA3dQszGeqT5L3Kw='; img-src 'self' data:; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
      },
      "continue": true
    },
    {
      "src": "/educacion(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
      },
      "continue": true
    },
    {
      "src": "/edu/?$",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
      },
      "continue": true
    },
    {
      "src": "/edu/(alta|centros)(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY",
        "Cross-Origin-Opener-Policy": "same-origin-allow-popups",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' https://accounts.google.com/gsi/style 'unsafe-hashes' 'sha256-RU4sU0AaS8IBGZx8XrGt/pa9A5SLA3dQszGeqT5L3Kw='; img-src 'self' data:; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
      },
      "continue": true
    },
    {
      "src": "/edu/administracion(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
      },
      "continue": true
    },
    {
      "src": "/edu/documentos/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
      },
      "continue": true
    },
    {
      "src": "/api/junior/(.*)",
      "dest": "https://rsp.laplaceta.org/api/junior/$1"
    },
    {
      "src": "/api/config",
      "dest": "/api/centros.js?ruta=config"
    },
    {
      "src": "/api/centros/mi",
      "dest": "/api/centros.js?ruta=mi"
    },
    {
      "src": "/api/centros/solicitud",
      "dest": "/api/centros.js?ruta=solicitud"
    },
    {
      "src": "/api/creadores/actividades",
      "dest": "/api/centros.js?ruta=crear-actividad"
    },
    {
      "src": "/api/centros/([^/]+)/dispositivos/configuracion",
      "dest": "/api/centros.js?ruta=config-dispositivos&orgId=$1"
    },
    {
      "src": "/api/centros/([^/]+)/dispositivos/configuracion/guardar",
      "dest": "/api/centros.js?ruta=guardar-config-dispositivos&orgId=$1"
    },
    {
      "src": "/api/centros/([^/]+)/dispositivos/([^/]+)/desvincular",
      "dest": "/api/centros.js?ruta=desvincular-dispositivo&orgId=$1&deviceId=$2"
    },
    {
      "src": "/api/centros/([^/]+)/dispositivos",
      "dest": "/api/centros.js?ruta=dispositivos&orgId=$1"
    },
    {
      "src": "/api/centros/([^/]+)",
      "dest": "/api/centros.js?ruta=org&orgId=$1"
    },
    {
      "src": "/api/rsp/solicitudes",
      "dest": "/api/centros.js?ruta=rsp-lista"
    },
    {
      "src": "/api/rsp/solicitudes/([^/]+)",
      "dest": "/api/centros.js?ruta=rsp-decision&id=$1"
    },
    {
      "src": "/api/(admin|dispositivo)/(.*)",
      "dest": "/api/educacion.js?ruta=$1/$2"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/info",
      "status": 308,
      "headers": {
        "Location": "/#/info"
      }
    },
    {
      "src": "/familias-docentes(?:/.*)?",
      "status": 308,
      "headers": {
        "Location": "/#/familias"
      }
    },
    {
      "src": "/colecciones(?:/.*)?",
      "status": 308,
      "headers": {
        "Location": "/#/actividades"
      }
    },
    {
      "src": "/jugar",
      "dest": "/public/jugar.html"
    },
    {
      "src": "/aviso-legal",
      "dest": "/public/aviso-legal.html"
    },
    {
      "src": "/privacidad",
      "dest": "/public/privacidad.html"
    },
    {
      "src": "/terminos",
      "dest": "/public/terminos.html"
    },
    {
      "src": "/cookies",
      "dest": "/public/cookies.html"
    },
    {
      "src": "/studio/?$",
      "status": 308,
      "headers": {
        "Location": "/edu/studio"
      }
    },
    {
      "src": "/studio.html",
      "status": 308,
      "headers": {
        "Location": "/edu/studio"
      }
    },
    {
      "src": "/edu/?$",
      "dest": "/public/education/index.html"
    },
    {
      "src": "/edu/alta/?$",
      "dest": "/public/education/centers/index.html"
    },
    {
      "src": "/edu/centros/?$",
      "dest": "/public/education/centers/panel.html"
    },
    {
      "src": "/edu/administracion/?$",
      "dest": "/public/education/admin/admin.html"
    },
    {
      "src": "/edu/studio/?$",
      "dest": "/public/education/studio/index.html"
    },
    {
      "src": "/edu/documentos/(.*)",
      "dest": "/public/education/centers/docs/$1"
    },
    {
      "src": "/edu/assets/(centros|centers)/(.*)",
      "dest": "/public/education/centers/assets/$2"
    },
    {
      "src": "/edu/assets/portal\\.css",
      "dest": "/public/education/admin/portal.css"
    },
    {
      "src": "/edu/assets/portal\\.js",
      "dest": "/public/education/admin/portal.js"
    },
    {
      "src": "/edu/assets/studio-creadores\\.css",
      "dest": "/public/education/studio/studio.css"
    },
    {
      "src": "/edu/assets/studio-creadores\\.js",
      "dest": "/public/education/studio/studio.js"
    },
    {
      "src": "/edu/assets/(hub\\.css|hub\\.js|navigation\\.css|admin\\.css|legacy-redirect\\.js)",
      "dest": "/public/education/assets/$1"
    },
    {
      "src": "/crear-actividad",
      "dest": "/public/education/studio/index.html"
    },
    {
      "src": "/centros/assets/(.*)",
      "dest": "/public/education/centers/assets/$1"
    },
    {
      "src": "/centros/rsp\\.html",
      "dest": "/public/education/centers/rsp.html"
    },
    {
      "src": "/educacion/?$",
      "dest": "/public/education/admin/index.html"
    },
    {
      "src": "/educacion/administracion/?$",
      "dest": "/public/education/admin/admin.html"
    },
    {
      "src": "/css/edu-hub\\.css",
      "dest": "/public/education/assets/hub.css"
    },
    {
      "src": "/js/edu-hub\\.js",
      "dest": "/public/education/assets/hub.js"
    },
    {
      "src": "/js/edu-legacy-redirect\\.js",
      "dest": "/public/education/assets/legacy-redirect.js"
    },
    {
      "src": "/css/education-nav\\.css",
      "dest": "/public/education/assets/navigation.css"
    },
    {
      "src": "/css/pj-admin\\.css",
      "dest": "/public/education/assets/admin.css"
    },
    {
      "src": "/css/code-responsive\\.css",
      "dest": "/public/code/responsive.css"
    },
    {
      "src": "/js/code-engine\\.js",
      "dest": "/public/code/engine.js"
    },
    {
      "src": "/devai",
      "dest": "/public/devai.html"
    },
    {
      "src": "/centros/?$",
      "dest": "/public/education/centers/index.html"
    },
    {
      "src": "/centros/panel/?$",
      "dest": "/public/education/centers/panel.html"
    },
    {
      "src": "/educacion$",
      "status": 308,
      "headers": {
        "Location": "/edu/centros"
      }
    },
    {
      "src": "/educacion/?$",
      "dest": "/public/education/admin/index.html"
    },
    {
      "src": "/educacion/administracion/?$",
      "dest": "/public/education/admin/admin.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1",
      "check": true
    },
    {
      "src": "/(.*)",
      "dest": "/public/404.html",
      "status": 404
    }
  ]
}