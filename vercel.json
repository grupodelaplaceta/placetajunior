{
  "version": 2,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "api/**", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/sitemap.xml", "dest": "/api/sitemap" },
    { "src": "/actividades", "dest": "/public/index.html" },
    { "src": "/actividades/(.*)", "dest": "/public/index.html" },
    { "src": "/categorias", "dest": "/public/index.html" },
    { "src": "/categorias/(.*)", "dest": "/public/index.html" },
    { "src": "/studio", "dest": "/public/studio.html" },
    { "src": "/devai", "dest": "/public/devai.html" },
    { "src": "/info", "dest": "/public/info.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
