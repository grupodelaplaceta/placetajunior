{
  "version": 2,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/studio", "dest": "/public/index.html" },
    { "src": "/devai", "dest": "/public/index.html" },
    { "src": "/info", "dest": "/public/info.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
