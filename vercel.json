{
  "version": 2,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/junior/(.*)", "dest": "https://rsp.laplaceta.org/api/junior/$1" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/info", "status": 308, "headers": { "Location": "/#/info" } },
    { "src": "/familias-docentes(?:/.*)?", "status": 308, "headers": { "Location": "/#/familias" } },
    { "src": "/colecciones(?:/.*)?", "status": 308, "headers": { "Location": "/#/actividades" } },
    { "src": "/jugar", "dest": "/public/jugar.html" },
    { "src": "/aviso-legal", "dest": "/public/aviso-legal.html" },
    { "src": "/privacidad", "dest": "/public/privacidad.html" },
    { "src": "/terminos", "dest": "/public/terminos.html" },
    { "src": "/cookies", "dest": "/public/cookies.html" },
    { "src": "/studio", "dest": "/public/studio.html" },
    { "src": "/devai", "dest": "/public/devai.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
